# ==========================================
# ManagerPC PRO - .gitignore
# ==========================================

# --- Python & PyInstaller Build Outputs ---
__pycache__/
*.py[cod]
*$py.class
*.manifest
*.spec

# PyInstaller / Build & Release Directories
build/
dist/
release/

# Executables & Binaries (PyInstaller builds)
*.exe
*.dll
*.so
*.dylib
*.bin
*.msi

# Archives
*.zip
*.tar.gz
*.rar
*.7z

# --- Virtual Environments ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# --- Security & Credentials (SSL/TLS, Secrets) ---
*.pem
*.key
*.crt
*.cer
*.pfx
*.p12
.env
.env.*
!.env.example
secrets.json

# --- Logs & Runtime Data ---
*.log
logs/
*.sqlite
*.sqlite3
*.db

# --- Testing & Coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# --- Node / Frontend (agar kerak bo'lsa) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- IDEs & Editors ---
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# --- OS Generated Files ---
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store
.Spotlight-V100
.Trashes

# --- Temporary Files ---
tmp/
temp/
*.tmp
*.bak

